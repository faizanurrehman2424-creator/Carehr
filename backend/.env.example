# CareHR Backend Environment Configuration Template
# Copy this file to .env and fill in your secrets.

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Local SQLite fallback (default):
# DATABASE_URL=sqlite:///./trendcraft.db
# 
# Supabase PostgreSQL connection URI:
# Standard Session/Direct Connection (Port 5432 or 6543):
# DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./trendcraft.db

# ==============================================================================
# EMAIL / SMTP SETTINGS
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=klauskite24@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=klauskite24@gmail.com
EMAIL_TO=manager@company.com

# ==============================================================================
# AI / CHATBOT SETTINGS
# ==============================================================================
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
